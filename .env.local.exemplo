# Chaves de geração de áudio. Copie para .env.local e preencha.
#
# .env.local é ignorado pelo git (padrão *.local no .gitignore) e é lido
# automaticamente por `npm run falas:gerar`. Chave de API não entra em
# arquivo versionado, não entra em conversa e não entra em captura de tela.

PROVEDOR=openai
OPENAI_API_KEY=

# Alternativas, se um dia trocar de provedor:
# PROVEDOR=azure
# AZURE_TTS_KEY=
# AZURE_TTS_REGION=brazilsouth
#
# PROVEDOR=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
